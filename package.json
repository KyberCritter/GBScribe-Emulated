{
  "name": "gbscribe-emulated",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GBScribe + Game Boy Printer in the browser, with GBA.js and a reusable GPIO link-port device layer.",
  "license": "MIT",
  "exports": {
    "./linkport": "./src/linkport/index.js",
    "./linkport/byte": "./src/linkport/byte-link.js",
